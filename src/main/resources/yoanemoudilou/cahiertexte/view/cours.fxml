<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" prefWidth="1080" prefHeight="760"
            fx:controller="yoanemoudilou.cahiertexte.ui.cours.CoursController"
            styleClass="app-shell">

    <top>
        <HBox styleClass="top-bar">
            <Label text="CO" styleClass="icon-badge, icon-badge-light"/>
            <VBox spacing="3">
                <Label text="Gestion des cours" styleClass="header-label"/>
                <Label text="Organisez les contenus et attribuez les enseignants depuis un seul ecran" styleClass="header-label-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Dashboard" onAction="#handleRetourDashboard" styleClass="button-ghost, module-back-button"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
        <VBox styleClass="page-content">
            <VBox styleClass="surface-card, hero-card">
                <Label text="Referentiel des cours" styleClass="page-title"/>
                <Label text="Gerez le code, l'intitule, la charge horaire et l'attribution a un enseignant dans une interface plus claire." styleClass="page-subtitle" wrapText="true"/>
            </VBox>

            <VBox styleClass="surface-card" VBox.vgrow="ALWAYS">
                <Label text="Cours enregistres" styleClass="section-title"/>
                <TableView fx:id="coursTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="55"/>
                        <TableColumn fx:id="codeColumn" text="Code" prefWidth="110"/>
                        <TableColumn fx:id="intituleColumn" text="Intitule" prefWidth="280"/>
                        <TableColumn fx:id="volumeHoraireColumn" text="Volume (h)" prefWidth="120"/>
                        <TableColumn fx:id="classeColumn" text="Classe / Filiere" prefWidth="300"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox styleClass="surface-card">
                <Label text="Edition et attribution" styleClass="section-title"/>
                <GridPane hgap="16" vgap="12">
                    <Label text="Code" styleClass="helper-text" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="codeField" prefWidth="160" GridPane.columnIndex="0" GridPane.rowIndex="1"/>

                    <Label text="Intitule" styleClass="helper-text" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <TextField fx:id="intituleField" prefWidth="280" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Volume horaire" styleClass="helper-text" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <TextField fx:id="volumeHoraireField" prefWidth="160" GridPane.columnIndex="2" GridPane.rowIndex="1"/>

                    <Label text="Filiere" styleClass="helper-text" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="filiereField" prefWidth="220" editable="false" GridPane.columnIndex="0" GridPane.rowIndex="3"/>

                    <Label text="Classe" styleClass="helper-text" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <ComboBox fx:id="classeComboBox" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Attribuer a" styleClass="helper-text" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <ComboBox fx:id="enseignantComboBox" prefWidth="240" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                </GridPane>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="+ Nouveau" onAction="#handleNouveau" prefWidth="120"/>
                    <Button text="Enregistrer" onAction="#handleEnregistrer" prefWidth="150" styleClass="button-success"/>
                    <Button text="Supprimer" onAction="#handleSupprimer" prefWidth="140" styleClass="button-danger"/>
                    <Button text="Attribuer le cours" onAction="#handleAttribuerCours" prefWidth="180" styleClass="button-accent"/>
                    <Button text="Rafraichir" onAction="#handleRafraichir" prefWidth="140" styleClass="button-soft"/>
                </HBox>
            </VBox>
        </VBox>
        </ScrollPane>
    </center>

</BorderPane>
