<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" prefWidth="1140" prefHeight="760"
            fx:controller="yoanemoudilou.cahiertexte.ui.dashboard.AdminDashboardController"
            styleClass="app-shell">

    <top>
        <HBox styleClass="top-bar">
            <Label text="CT" styleClass="icon-badge, icon-badge-light"/>
            <VBox spacing="3">
                <Label fx:id="bienvenuLabel" text="Bienvenue" styleClass="header-label"/>
                <Label text="Pilotage de la structure pedagogique" styleClass="header-label-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="8" alignment="CENTER">
                <Button text="🔔 Notifications" onAction="#handleNotifications" styleClass="notification-button"/>
                <Label fx:id="notificationsCountLabel" text="0" styleClass="notification-badge"/>
            </HBox>
            <Label fx:id="roleLabel" text="CHEF_DEPARTEMENT" styleClass="status-pill"/>
            <Button text="Deconnexion" onAction="#handleLogout" styleClass="button-ghost"/>
        </HBox>
    </top>

    <left>
        <VBox styleClass="sidebar">
            <VBox spacing="3">
                <Label text="Navigation" styleClass="nav-title"/>
                <Label text="Acces rapide aux modules" styleClass="nav-subtitle"/>
            </VBox>
            <Button text="⌂ Tableau de bord" onAction="#handleRafraichir" styleClass="nav-button-active"/>
            <Button text="◫ Utilisateurs" onAction="#handleUsers" styleClass="nav-button"/>
            <Button text="✦ Enseignants" onAction="#handleEnseignants" styleClass="nav-button"/>
            <Button text="◧ Filieres" onAction="#handleOuvrirFilieres" styleClass="nav-button"/>
            <Button text="▣ Classes" onAction="#handleOuvrirClasses" styleClass="nav-button"/>
            <Button text="◉ Cours" onAction="#handleCours" styleClass="nav-button"/>
            <Button text="☰ Cahiers de texte" onAction="#handleOuvrirCahiers" styleClass="nav-button"/>
            <Button text="✓ Validation" onAction="#handleValidationSeances" styleClass="nav-button"/>
            <Region minHeight="12"/>
            <Button text="✉ Notifications" onAction="#handleNotifications" styleClass="nav-button"/>
            <Button text="◌ Statistiques" onAction="#handleStatistiques" styleClass="nav-button"/>
            <Button text="↗ Rapports" onAction="#handleRapports" styleClass="nav-button"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentContainer">
            <ScrollPane fx:id="dashboardContent" fitToWidth="true" styleClass="content-scroll">
            <VBox styleClass="page-content">
                <HBox spacing="18" styleClass="surface-card, hero-card">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Vue d'ensemble" styleClass="page-title"/>
                        <Label text="Retrouvez les indicateurs essentiels, les validations en attente et les notifications recentes dans une interface plus lisible." styleClass="page-subtitle" wrapText="true"/>
                    </VBox>
                    <VBox alignment="CENTER_RIGHT" spacing="8">
                        <Label text="Administration" styleClass="helper-text"/>
                        <Button text="↻ Rafraichir" onAction="#handleRafraichir" prefWidth="150"/>
                    </VBox>
                </HBox>

                <GridPane hgap="16" vgap="16">
                    <VBox styleClass="metric-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Utilisateurs" styleClass="metric-caption"/>
                        <Label fx:id="totalUtilisateursLabel" text="0" styleClass="metric-value"/>
                    </VBox>
                    <VBox styleClass="metric-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Enseignants" styleClass="metric-caption"/>
                        <Label fx:id="totalEnseignantsLabel" text="0" styleClass="metric-value"/>
                    </VBox>
                    <VBox styleClass="metric-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="Responsables" styleClass="metric-caption"/>
                        <Label fx:id="totalResponsablesLabel" text="0" styleClass="metric-value"/>
                    </VBox>
                    <VBox styleClass="metric-card" GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <Label text="En attente de validation" styleClass="metric-caption"/>
                        <Label fx:id="utilisateursEnAttenteLabel" text="0" styleClass="metric-value-warning"/>
                    </VBox>
                </GridPane>

                <GridPane hgap="16" vgap="16">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>
                    <VBox styleClass="surface-card, summary-panel" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Structure pedagogique" styleClass="section-title"/>
                        <Label text="Organisation globale des filieres, classes et cours" styleClass="section-subtitle"/>
                        <HBox spacing="14">
                            <VBox styleClass="summary-stat" HBox.hgrow="ALWAYS">
                                <Label text="Filieres" styleClass="metric-caption"/>
                                <Label fx:id="totalFilieresLabel" text="0" styleClass="metric-value"/>
                            </VBox>
                            <VBox styleClass="summary-stat" HBox.hgrow="ALWAYS">
                                <Label text="Classes" styleClass="metric-caption"/>
                                <Label fx:id="totalClassesLabel" text="0" styleClass="metric-value"/>
                            </VBox>
                            <VBox styleClass="summary-stat" HBox.hgrow="ALWAYS">
                                <Label text="Cours" styleClass="metric-caption"/>
                                <Label fx:id="totalCoursLabel" text="0" styleClass="metric-value"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox styleClass="surface-card, summary-panel" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Suivi des seances" styleClass="section-title"/>
                        <Label text="Etat des saisies et validations" styleClass="section-subtitle"/>
                        <GridPane hgap="14" vgap="14">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>
                            <VBox styleClass="summary-stat" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Total" styleClass="metric-caption"/>
                                <Label fx:id="totalSeancesLabel" text="0" styleClass="metric-value"/>
                            </VBox>
                            <VBox styleClass="summary-stat" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="En attente" styleClass="metric-caption"/>
                                <Label fx:id="seancesEnAttenteLabel" text="0" styleClass="metric-value-warning"/>
                            </VBox>
                            <VBox styleClass="summary-stat" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="Validees" styleClass="metric-caption"/>
                                <Label fx:id="seancesValideesLabel" text="0" styleClass="metric-value-success"/>
                            </VBox>
                            <VBox styleClass="summary-stat" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Rejetees" styleClass="metric-caption"/>
                                <Label fx:id="seancesRejeteesLabel" text="0" styleClass="metric-value-danger"/>
                            </VBox>
                        </GridPane>
                    </VBox>
                </GridPane>
            </VBox>
            </ScrollPane>
        </StackPane>
    </center>
</BorderPane>
