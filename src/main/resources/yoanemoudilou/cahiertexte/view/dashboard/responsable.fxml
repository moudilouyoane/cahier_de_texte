<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" prefWidth="1100" prefHeight="760"
            fx:controller="yoanemoudilou.cahiertexte.ui.dashboard.ResponsableDashboardController"
            styleClass="app-shell">

    <top>
        <HBox styleClass="top-bar">
            <Label text="RC" styleClass="icon-badge, icon-badge-light"/>
            <VBox spacing="3">
                <Label fx:id="bienvenuLabel" text="Bienvenue" styleClass="header-label"/>
                <Label text="Controle des seances et suivi de la classe" styleClass="header-label-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="8" alignment="CENTER">
                <Button text="🔔" onAction="#handleToggleNotifications" styleClass="notification-button"/>
                <Label fx:id="notificationsCountLabel" text="0" styleClass="notification-badge"/>
            </HBox>
            <Button text="☰ Cahier de texte" onAction="#handleOuvrirCahierTexte" styleClass="button-accent"/>
            <Button text="↗ Rapports" onAction="#handleOuvrirRapports"/>
            <Button text="↻ Rafraichir" onAction="#handleRafraichir" styleClass="button-soft"/>
            <Button text="Deconnexion" onAction="#handleLogout" styleClass="button-ghost"/>
        </HBox>
    </top>

    <center>
        <StackPane>
            <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <VBox styleClass="page-content">
            <HBox spacing="16" alignment="CENTER_LEFT" styleClass="surface-card, hero-card">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Validation des seances" styleClass="page-title"/>
                    <Label text="Filtrez votre classe, consultez les saisies a valider et ajoutez un commentaire avant decision." styleClass="page-subtitle" wrapText="true"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Classe attribuee" styleClass="helper-text"/>
                    <ComboBox fx:id="classeFilterComboBox" prefWidth="220" onAction="#handleFiltrerParClasse"/>
                </VBox>
            </HBox>

            <GridPane hgap="16" vgap="16">
                <VBox styleClass="metric-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Cours" styleClass="metric-caption"/>
                    <Label fx:id="totalCoursLabel" text="0" styleClass="metric-value"/>
                </VBox>
                <VBox styleClass="metric-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Seances" styleClass="metric-caption"/>
                    <Label fx:id="totalSeancesLabel" text="0" styleClass="metric-value"/>
                </VBox>
                <VBox styleClass="metric-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <Label text="En attente" styleClass="metric-caption"/>
                    <Label fx:id="seancesEnAttenteLabel" text="0" styleClass="metric-value-warning"/>
                </VBox>
                <VBox styleClass="metric-card" GridPane.columnIndex="3" GridPane.rowIndex="0">
                    <Label text="Validees" styleClass="metric-caption"/>
                    <Label fx:id="seancesValideesLabel" text="0" styleClass="metric-value-success"/>
                </VBox>
            </GridPane>

            <VBox styleClass="surface-card" VBox.vgrow="ALWAYS">
                <Label text="Seances a valider" styleClass="section-title"/>
                <Label text="Selectionnez une ligne pour afficher le commentaire de validation" styleClass="section-subtitle"/>
                <TableView fx:id="seancesTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="dateColumn" text="Date" prefWidth="110"/>
                        <TableColumn fx:id="heureColumn" text="Heure" prefWidth="90"/>
                        <TableColumn fx:id="coursColumn" text="Cours" prefWidth="180"/>
                        <TableColumn fx:id="enseignantColumn" text="Enseignant" prefWidth="180"/>
                        <TableColumn fx:id="statutColumn" text="Statut" prefWidth="120"/>
                        <TableColumn fx:id="contenuColumn" text="Contenu" prefWidth="260"/>
                        <TableColumn fx:id="observationsColumn" text="Observations" prefWidth="240"/>
                    </columns>
                </TableView>
            </VBox>

            <HBox spacing="18">
                <VBox spacing="10" styleClass="surface-card" HBox.hgrow="ALWAYS">
                    <Label text="Commentaire de validation" styleClass="section-title"/>
                    <Label text="Entrer le commentaire ici" styleClass="helper-text"/>
                    <TextArea fx:id="commentaireArea" prefHeight="92"/>
                    <HBox spacing="12">
                        <Button text="✓ Valider" onAction="#handleValiderSeance" prefWidth="140" styleClass="button-success"/>
                        <Button text="✕ Rejeter" onAction="#handleRejeterSeance" prefWidth="140" styleClass="button-danger"/>
                    </HBox>
                </VBox>
            </HBox>
            </VBox>
            </ScrollPane>

            <VBox fx:id="notificationsPanel"
                  spacing="10"
                  styleClass="notification-panel, notification-drawer"
                  prefWidth="340"
                  visible="false"
                  managed="false"
                  StackPane.alignment="TOP_RIGHT">
                <StackPane.margin>
                    <Insets top="22" right="22" bottom="22" left="22"/>
                </StackPane.margin>
                <Label text="Notifications" styleClass="section-title"/>
                <ListView fx:id="notificationsListView" prefHeight="180"/>
            </VBox>

        </StackPane>
    </center>
</BorderPane>
