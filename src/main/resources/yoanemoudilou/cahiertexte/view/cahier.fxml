<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" prefWidth="1140" prefHeight="780"
            fx:controller="yoanemoudilou.cahiertexte.ui.cahier.CahierTexteController"
            styleClass="app-shell">

    <top>
        <HBox styleClass="top-bar">
            <Label text="CT" styleClass="icon-badge, icon-badge-light"/>
            <VBox spacing="3">
                <Label fx:id="titreLabel" text="Cahiers de texte" styleClass="header-label"/>
                <Label text="Consultez les cahiers et leurs seances dans une vue de suivi plus lisible" styleClass="header-label-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Classe" styleClass="helper-text"/>
            <ComboBox fx:id="classeFilterComboBox" prefWidth="220" onAction="#handleFiltrer"/>
            <Button text="Rafraichir" onAction="#handleRafraichir" styleClass="button-soft"/>
            <Button text="Dashboard" onAction="#handleRetourDashboard" styleClass="button-ghost, module-back-button"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
        <VBox styleClass="page-content">
            <VBox styleClass="surface-card, hero-card">
                <Label fx:id="detailsLabel" text="Selectionnez un cahier de texte pour afficher son contenu." styleClass="page-subtitle" wrapText="true"/>
            </VBox>

            <SplitPane dividerPositions="0.36" VBox.vgrow="ALWAYS">
                <VBox styleClass="surface-card">
                    <Label text="Cahiers de texte" styleClass="section-title"/>
                    <TableView fx:id="cahiersTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="cahierClasseColumn" text="Classe" prefWidth="180"/>
                            <TableColumn fx:id="cahierAnneeColumn" text="Annee" prefWidth="110"/>
                            <TableColumn fx:id="cahierSemestreColumn" text="Semestre" prefWidth="110"/>
                            <TableColumn fx:id="cahierDateCreationColumn" text="Creation" prefWidth="160"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox styleClass="surface-card">
                    <Label text="Contenu du cahier" styleClass="section-title"/>
                    <TableView fx:id="seancesTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="seanceDateColumn" text="Date" prefWidth="100"/>
                            <TableColumn fx:id="seanceHeureColumn" text="Heure" prefWidth="90"/>
                            <TableColumn fx:id="seanceCoursColumn" text="Cours" prefWidth="240"/>
                            <TableColumn fx:id="seanceEnseignantColumn" text="Enseignant" prefWidth="180"/>
                            <TableColumn fx:id="seanceStatutColumn" text="Statut" prefWidth="110"/>
                            <TableColumn fx:id="seanceContenuColumn" text="Contenu" prefWidth="280"/>
                        </columns>
                    </TableView>
                </VBox>
            </SplitPane>
        </VBox>
        </ScrollPane>
    </center>

</BorderPane>
