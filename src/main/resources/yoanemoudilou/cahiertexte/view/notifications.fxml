<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" spacing="18"
      fx:controller="yoanemoudilou.cahiertexte.ui.dashboard.NotificationsCenterController"
      styleClass="page-content">

    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="surface-card, hero-card">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Centre de notifications" styleClass="page-title"/>
            <Label text="Consultez tous les messages recents et gardez un point d'entree unique accessible depuis la navigation." styleClass="page-subtitle" wrapText="true"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="↻ Rafraichir" onAction="#handleRafraichir" styleClass="button-soft"/>
    </HBox>

    <HBox spacing="16">
        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="Total charge" styleClass="metric-caption"/>
            <Label fx:id="totalNotificationsLabel" text="0" styleClass="metric-value"/>
        </VBox>
        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="Non lues" styleClass="metric-caption"/>
            <Label fx:id="notificationsNonLuesLabel" text="0" styleClass="metric-value-warning"/>
        </VBox>
    </HBox>

    <VBox styleClass="surface-card" VBox.vgrow="ALWAYS">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Historique recent" styleClass="section-title"/>
                <Label text="Les notifications les plus recentes sont listees ici avec leur horodatage." styleClass="section-subtitle"/>
            </VBox>
            <Button text="Tout marquer comme lu" onAction="#handleMarquerToutCommeLu" styleClass="button-accent"/>
        </HBox>
        <ListView fx:id="notificationsListView" VBox.vgrow="ALWAYS"/>
    </VBox>
</VBox>
