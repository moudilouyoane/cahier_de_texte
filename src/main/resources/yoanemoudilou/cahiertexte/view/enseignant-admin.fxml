<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" prefWidth="1080" prefHeight="760"
            fx:controller="yoanemoudilou.cahiertexte.ui.enseignants.EnseignantAssignmentController"
            styleClass="app-shell">

    <top>
        <HBox styleClass="top-bar">
            <Label text="EN" styleClass="icon-badge, icon-badge-light"/>
            <VBox spacing="3">
                <Label text="Enseignants et affectations" styleClass="header-label"/>
                <Label text="Attribuez les cours et suivez les charges avec une lecture immediate" styleClass="header-label-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Dashboard" onAction="#handleRetourDashboard" styleClass="button-ghost, module-back-button"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
        <VBox styleClass="page-content">
            <GridPane hgap="16" vgap="16">
                <VBox styleClass="surface-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Selection des enseignants" styleClass="section-title"/>
                    <Label text="Choisissez un enseignant pour afficher ses cours deja attribues." styleClass="section-subtitle" wrapText="true"/>
                    <TableView fx:id="enseignantsTable" prefHeight="250">
                        <columns>
                            <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="nomCompletColumn" text="Enseignant" prefWidth="220"/>
                            <TableColumn fx:id="emailColumn" text="Email" prefWidth="250"/>
                            <TableColumn fx:id="valideColumn" text="Valide" prefWidth="80"/>
                            <TableColumn fx:id="actifColumn" text="Actif" prefWidth="80"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox styleClass="surface-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Attribuer un cours" styleClass="section-title"/>
                    <Label text="Le cours selectionne sera lie a l'enseignant choisi et les notifications seront declenchees." styleClass="section-subtitle" wrapText="true"/>
                    <GridPane hgap="16" vgap="12">
                        <Label text="Cours" styleClass="helper-text" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="coursComboBox" prefWidth="360" GridPane.columnIndex="0" GridPane.rowIndex="1"/>

                        <Label text="Classe" styleClass="helper-text" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <TextField fx:id="classeField" editable="false" prefWidth="220" GridPane.columnIndex="0" GridPane.rowIndex="3"/>

                        <Label text="Filiere" styleClass="helper-text" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <TextField fx:id="filiereField" editable="false" prefWidth="220" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                        <Label text="Volume horaire" styleClass="helper-text" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                        <TextField fx:id="volumeHoraireField" editable="false" prefWidth="160" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                    </GridPane>

                    <HBox spacing="10">
                        <Button text="Attribuer le cours" onAction="#handleAttribuerCours" prefWidth="180" styleClass="button-accent"/>
                        <Button text="Rafraichir" onAction="#handleRafraichir" prefWidth="140" styleClass="button-soft"/>
                    </HBox>
                </VBox>
            </GridPane>

            <VBox styleClass="surface-card" VBox.vgrow="ALWAYS">
                <Label text="Cours deja attribues a l'enseignant selectionne" styleClass="section-title"/>
                <TableView fx:id="affectationsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="codeCoursColumn" text="Code" prefWidth="110"/>
                        <TableColumn fx:id="intituleCoursColumn" text="Intitule" prefWidth="290"/>
                        <TableColumn fx:id="volumeColumn" text="Volume (h)" prefWidth="120"/>
                        <TableColumn fx:id="classeCoursColumn" text="Classe / Filiere" prefWidth="300"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
        </ScrollPane>
    </center>

</BorderPane>
