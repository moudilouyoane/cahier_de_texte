<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" prefWidth="1020" prefHeight="720"
            fx:controller="yoanemoudilou.cahiertexte.ui.filieres.FiliereManagementController"
            styleClass="app-shell">

    <top>
        <HBox styleClass="top-bar">
            <Label text="FI" styleClass="icon-badge, icon-badge-light"/>
            <VBox spacing="3">
                <Label text="Gestion des filieres" styleClass="header-label"/>
                <Label text="Gardez une nomenclature claire et coherente pour toute la structure pedagogique" styleClass="header-label-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Dashboard" onAction="#handleRetourDashboard" styleClass="button-ghost, module-back-button"/>
        </HBox>
    </top>

    <center>
        <VBox styleClass="page-content">
            <VBox styleClass="surface-card, hero-card">
                <Label text="Catalogue des filieres" styleClass="page-title"/>
                <Label text="Centralisez les codes et intitules dans une vue simple, moderne et facile a maintenir." styleClass="page-subtitle" wrapText="true"/>
            </VBox>

            <VBox styleClass="surface-card" VBox.vgrow="ALWAYS">
                <Label text="Filieres enregistrees" styleClass="section-title"/>
                <TableView fx:id="filieresTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="70"/>
                        <TableColumn fx:id="codeColumn" text="Code" prefWidth="180"/>
                        <TableColumn fx:id="nomColumn" text="Nom" prefWidth="560"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox styleClass="surface-card">
                <Label text="Edition" styleClass="section-title"/>
                <GridPane hgap="16" vgap="12">
                    <Label text="Code" styleClass="helper-text" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="codeField" prefWidth="220" GridPane.columnIndex="0" GridPane.rowIndex="1"/>

                    <Label text="Nom" styleClass="helper-text" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <TextField fx:id="nomField" prefWidth="420" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                </GridPane>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="+ Nouveau" onAction="#handleNouveau" prefWidth="120"/>
                    <Button text="Enregistrer" onAction="#handleEnregistrer" prefWidth="150" styleClass="button-success"/>
                    <Button text="Supprimer" onAction="#handleSupprimer" prefWidth="140" styleClass="button-danger"/>
                    <Button text="Rafraichir" onAction="#handleRafraichir" prefWidth="140" styleClass="button-soft"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

</BorderPane>
