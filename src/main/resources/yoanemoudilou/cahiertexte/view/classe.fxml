<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" prefWidth="1040" prefHeight="720"
            fx:controller="yoanemoudilou.cahiertexte.ui.classes.ClasseManagementController"
            styleClass="app-shell">

    <top>
        <HBox styleClass="top-bar">
            <Label text="CL" styleClass="icon-badge, icon-badge-light"/>
            <VBox spacing="3">
                <Label text="Gestion des classes" styleClass="header-label"/>
                <Label text="Structurez clairement les promotions, niveaux et filieres associees" styleClass="header-label-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Dashboard" onAction="#handleRetourDashboard" styleClass="button-ghost, module-back-button"/>
        </HBox>
    </top>

    <center>
        <VBox styleClass="page-content">
            <VBox styleClass="surface-card, hero-card">
                <Label text="Repertoire des classes" styleClass="page-title"/>
                <Label text="Creez ou mettez a jour les classes avec leur niveau et leur filiere dans une interface plus lisible." styleClass="page-subtitle" wrapText="true"/>
            </VBox>

            <VBox styleClass="surface-card" VBox.vgrow="ALWAYS">
                <Label text="Classes enregistrees" styleClass="section-title"/>
                <TableView fx:id="classesTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="70"/>
                        <TableColumn fx:id="nomClasseColumn" text="Classe" prefWidth="240"/>
                        <TableColumn fx:id="niveauColumn" text="Niveau" prefWidth="180"/>
                        <TableColumn fx:id="filiereColumn" text="Filiere" prefWidth="300"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox styleClass="surface-card">
                <Label text="Edition" styleClass="section-title"/>
                <GridPane hgap="16" vgap="12">
                    <Label text="Nom de classe" styleClass="helper-text" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="nomClasseField" prefWidth="240" GridPane.columnIndex="0" GridPane.rowIndex="1"/>

                    <Label text="Niveau" styleClass="helper-text" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <TextField fx:id="niveauField" prefWidth="220" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Filiere" styleClass="helper-text" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="filiereComboBox" prefWidth="240" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                </GridPane>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="+ Nouveau" onAction="#handleNouveau" prefWidth="120"/>
                    <Button text="Enregistrer" onAction="#handleEnregistrer" prefWidth="150" styleClass="button-success"/>
                    <Button text="Supprimer" onAction="#handleSupprimer" prefWidth="140" styleClass="button-danger"/>
                    <Button text="Rafraichir" onAction="#handleRafraichir" prefWidth="140" styleClass="button-soft"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

</BorderPane>
