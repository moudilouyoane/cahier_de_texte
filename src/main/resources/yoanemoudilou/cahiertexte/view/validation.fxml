<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" prefWidth="1080" prefHeight="760"
            fx:controller="yoanemoudilou.cahiertexte.ui.validation.ValidationSeanceController"
            styleClass="app-shell">

    <top>
        <HBox styleClass="top-bar">
            <Label text="VA" styleClass="icon-badge, icon-badge-light"/>
            <VBox spacing="3">
                <Label text="Validation des seances" styleClass="header-label"/>
                <Label text="Filtrez, verifiez et validez les seances depuis une seule vue" styleClass="header-label-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Dashboard" onAction="#handleRetourDashboard" styleClass="button-ghost, module-back-button"/>
        </HBox>
    </top>

    <center>
        <VBox styleClass="page-content">
            <HBox spacing="16" styleClass="surface-card, hero-card">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Centre de validation" styleClass="page-title"/>
                    <Label text="Appliquez un filtre par statut, consultez le contenu de la seance et prenez une decision rapidement." styleClass="page-subtitle" wrapText="true"/>
                </VBox>
                <VBox spacing="8">
                    <Label text="Statut" styleClass="helper-text"/>
                    <ComboBox fx:id="filtreStatutComboBox" prefWidth="180" onAction="#handleFiltrer"/>
                </VBox>
                <Button text="Rafraichir" onAction="#handleRafraichir" styleClass="button-soft"/>
            </HBox>

            <VBox styleClass="surface-card" VBox.vgrow="ALWAYS">
                <Label text="Seances a traiter" styleClass="section-title"/>
                <TableView fx:id="seancesTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="55"/>
                        <TableColumn fx:id="dateColumn" text="Date" prefWidth="110"/>
                        <TableColumn fx:id="heureColumn" text="Heure" prefWidth="90"/>
                        <TableColumn fx:id="coursColumn" text="Cours" prefWidth="170"/>
                        <TableColumn fx:id="enseignantColumn" text="Enseignant" prefWidth="180"/>
                        <TableColumn fx:id="statutColumn" text="Statut" prefWidth="110"/>
                        <TableColumn fx:id="contenuColumn" text="Contenu" prefWidth="220"/>
                        <TableColumn fx:id="observationsColumn" text="Observations" prefWidth="190"/>
                    </columns>
                </TableView>
            </VBox>

            <HBox spacing="18">
                <VBox spacing="10" styleClass="surface-card" HBox.hgrow="ALWAYS">
                    <Label text="Commentaire de validation" styleClass="section-title"/>
                    <Label text="Entrer le commentaire ici" styleClass="helper-text"/>
                    <TextArea fx:id="commentaireValidationArea" prefHeight="110"/>
                </VBox>

                <VBox spacing="10" styleClass="surface-card">
                    <Label text="Actions" styleClass="section-title"/>
                    <Button text="Valider" onAction="#handleValider" prefWidth="170" styleClass="button-success"/>
                    <Button text="Rejeter" onAction="#handleRejeter" prefWidth="170" styleClass="button-danger"/>
                    <Button text="Remettre en attente" onAction="#handleRemettreEnAttente" prefWidth="170" styleClass="button-soft"/>
                </VBox>
            </HBox>
        </VBox>
    </center>

</BorderPane>
