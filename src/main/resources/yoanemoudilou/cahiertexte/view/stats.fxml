<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" prefWidth="1140" prefHeight="780"
            fx:controller="yoanemoudilou.cahiertexte.ui.stats.StatistiqueController"
            styleClass="app-shell">

    <top>
        <HBox styleClass="top-bar">
            <Label text="ST" styleClass="icon-badge, icon-badge-light"/>
            <VBox spacing="3">
                <Label text="Statistiques" styleClass="header-label"/>
                <Label text="Suivez les volumes, les statuts et l'activite des enseignants dans un tableau de bord moderne" styleClass="header-label-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Dashboard" onAction="#handleRetourDashboard" styleClass="button-ghost, module-back-button"/>
        </HBox>
    </top>

    <center>
        <VBox styleClass="page-content">
            <HBox spacing="12" styleClass="surface-card, hero-card">
                <DatePicker fx:id="dateDebutPicker" promptText="Date debut"/>
                <DatePicker fx:id="dateFinPicker" promptText="Date fin"/>
                <ComboBox fx:id="classeFilterComboBox" prefWidth="180" promptText="Classe"/>
                <ComboBox fx:id="enseignantFilterComboBox" prefWidth="220" promptText="Enseignant"/>
                <Button text="Filtrer" onAction="#handleFiltrer" styleClass="button-accent"/>
                <Button text="Reinitialiser" onAction="#handleReinitialiserFiltres" styleClass="button-soft"/>
                <Button text="Rafraichir" onAction="#handleRafraichir" styleClass="button-soft"/>
            </HBox>

            <GridPane hgap="16" vgap="16">
                <VBox styleClass="metric-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Utilisateurs" styleClass="metric-caption"/>
                    <Label fx:id="totalUtilisateursLabel" text="0" styleClass="metric-value"/>
                </VBox>
                <VBox styleClass="metric-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Enseignants" styleClass="metric-caption"/>
                    <Label fx:id="totalEnseignantsLabel" text="0" styleClass="metric-value"/>
                </VBox>
                <VBox styleClass="metric-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <Label text="Cours" styleClass="metric-caption"/>
                    <Label fx:id="totalCoursLabel" text="0" styleClass="metric-value"/>
                </VBox>
                <VBox styleClass="metric-card" GridPane.columnIndex="3" GridPane.rowIndex="0">
                    <Label text="Seances" styleClass="metric-caption"/>
                    <Label fx:id="totalSeancesLabel" text="0" styleClass="metric-value"/>
                </VBox>
                <VBox styleClass="metric-card" GridPane.columnIndex="4" GridPane.rowIndex="0">
                    <Label text="Filieres" styleClass="metric-caption"/>
                    <Label fx:id="totalFilieresLabel" text="0" styleClass="metric-value"/>
                </VBox>
                <VBox styleClass="metric-card" GridPane.columnIndex="5" GridPane.rowIndex="0">
                    <Label text="Classes" styleClass="metric-caption"/>
                    <Label fx:id="totalClassesLabel" text="0" styleClass="metric-value"/>
                </VBox>
            </GridPane>

            <HBox spacing="18">
                <VBox styleClass="surface-card" HBox.hgrow="ALWAYS">
                    <Label text="Repartition des statuts" styleClass="section-title"/>
                    <PieChart fx:id="statutPieChart" prefHeight="280"/>
                </VBox>

                <VBox styleClass="surface-card" HBox.hgrow="ALWAYS">
                    <Label text="Activite par enseignant" styleClass="section-title"/>
                    <TableView fx:id="statsEnseignantTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="enseignantNomColumn" text="Enseignant" prefWidth="250"/>
                            <TableColumn fx:id="enseignantTotalColumn" text="Total" prefWidth="100"/>
                            <TableColumn fx:id="enseignantValideesColumn" text="Validees" prefWidth="110"/>
                            <TableColumn fx:id="enseignantAttenteColumn" text="En attente" prefWidth="110"/>
                            <TableColumn fx:id="enseignantRejeteesColumn" text="Rejetees" prefWidth="110"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>
        </VBox>
    </center>

</BorderPane>
